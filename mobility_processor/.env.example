# PostgreSQL is the official runtime database; integration tests require open_transit_test.
DB_CONNECTION=pgsql
PGSQL_HOST=postgres
PGSQL_PORT=5432
PGSQL_DATABASE=open_transit
PGSQL_USERNAME=mobility_processor_login
PGSQL_PASSWORD=
PGSQL_SSLMODE=prefer
# Optional existing group membership; provisioning is explicit, never automatic.
PGSQL_ROLE=mobility_processor_catalog
PORT=8080
SPTRANS_API_TOKEN=
VALKEY_HOST=valkey
VALKEY_PORT=6379
